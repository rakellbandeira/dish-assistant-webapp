{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "User Schema",
    "description": "Validation schema for the users collection",
    "required": ["_id", "email", "username", "password_hash", "terms_accepted_at", "created_at"],
    "properties": {
      "_id": {
        "bsonType": "objectId",
        "description": "Unique user identifier"
      },
      "email": {
        "bsonType": "string",
        "maxLength": 254,
        "pattern": "^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$",
        "description": "User email address (unique, stored trimmed and lowercased by the backend)"
      },
      "password_hash": {
        "bsonType": "string",
        "minLength": 60,
        "description": "Hashed password (bcrypt format)"
      },
      "username": {
        "bsonType": "string",
        "minLength": 3,
        "maxLength": 30,
        "pattern": "^[a-zA-Z0-9_-]+$",
        "description": "Display name chosen at registration (unique, case-insensitive)"
      },
      "terms_accepted_at": {
        "bsonType": "date",
        "description": "When the user accepted the Terms & Conditions and consented to AI use of their data"
      },
      "created_at": {
        "bsonType": "date",
        "description": "Account creation timestamp"
      },
      "updated_at": {
        "bsonType": "date",
        "description": "Last account update timestamp"
      }
    },
    "additionalProperties": false
  },
  "indexes": [
    {
      "key": { "email": 1 },
      "unique": true
    },
    {
      "key": { "username": 1 },
      "unique": true,
      "collation": { "locale": "en", "strength": 2 }
    },
    {
      "key": { "created_at": -1 }
    }
  ]
}
