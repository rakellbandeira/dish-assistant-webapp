{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Preferences Schema",
    "description": "Validation schema for the preferences collection (one document per user, same fields as the frontend preference form)",
    "required": ["_id", "user_id", "created_at", "updated_at"],
    "properties": {
      "_id": {
        "bsonType": "objectId",
        "description": "Unique preferences document identifier"
      },
      "user_id": {
        "bsonType": "objectId",
        "description": "Reference to user._id (one-to-one relationship)"
      },
      "liked_flavors": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Flavors the user enjoys, e.g. Spicy, Umami"
      },
      "liked_foods": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Foods/ingredients the user enjoys, e.g. Chicken, Rice"
      },
      "disliked_flavors": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Flavors the user wants to avoid"
      },
      "disliked_foods": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Foods/ingredients the user wants to avoid"
      },
      "cuisines": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Cuisines the user wants to see more of, e.g. Thai, Mexican"
      },
      "dietary": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Dietary restrictions, e.g. Vegetarian, Gluten-free"
      },
      "allergies": {
        "bsonType": "array",
        "maxItems": 30,
        "items": { "bsonType": "string", "maxLength": 50 },
        "description": "Food allergies (free text), e.g. Peanuts, Shellfish"
      },
      "tried_dishes": {
        "bsonType": "array",
        "maxItems": 50,
        "items": {
          "bsonType": "object",
          "required": ["name", "rating"],
          "properties": {
            "id": { "bsonType": ["string", "null"], "description": "Row id from the frontend form" },
            "name": { "bsonType": "string", "minLength": 1, "maxLength": 200 },
            "rating": { "bsonType": "int", "minimum": 1, "maximum": 5, "description": "1 = disliked ... 5 = loved" }
          },
          "additionalProperties": false
        },
        "description": "Dishes the user has tried, with a 1-5 rating"
      },
      "created_at": {
        "bsonType": "date",
        "description": "Preferences document creation timestamp"
      },
      "updated_at": {
        "bsonType": "date",
        "description": "Last preferences update timestamp"
      }
    },
    "additionalProperties": false
  },
  "indexes": [
    {
      "key": { "user_id": 1 },
      "unique": true
    }
  ]
}
